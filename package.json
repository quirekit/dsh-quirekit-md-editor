{
  "name": "dsh-quirekit-md-editor",
  "version": "0.1.1",
  "description": "Edit Markdown in place in the DeepSeek Harness right sidebar with QuireKit MD Editor.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quirekit/dsh-quirekit-md-editor.git"
  },
  "homepage": "https://github.com/quirekit/dsh-quirekit-md-editor#readme",
  "bugs": {
    "url": "https://github.com/quirekit/dsh-quirekit-md-editor/issues"
  },
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "markdown",
    "editor",
    "quirekit"
  ],
  "icon": "./icon.svg",
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src/host",
    "skills",
    "lib",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.zh-CN.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "external": []
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepack": "npm test && npm run build",
    "benchmark": "node benchmark/run.mjs",
    "benchmark:fidelity": "node benchmark/fidelity.mjs"
  },
  "devDependencies": {
    "@ark-ui/vue": "^5.40.0",
    "@quirekit/md-editor": "^0.0.2",
    "@quirekit/md-editor-comments": "^0.0.2",
    "@quirekit/msfe-comments": "^0.0.2",
    "@quirekit/ui": "^0.0.2",
    "@quirekit/unocss-preset": "^0.0.2",
    "esbuild": "^0.25.12",
    "playwright": "1.61.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "unplugin-vue": "^7.2.0",
    "vue": "^3.5.40"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
